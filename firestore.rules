rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isMe(uid) { return signedIn() && request.auth.uid == uid; }

    // Datos privados de cada usuario (entrenos, comidas, peso, ajustes)
    match /users/{uid}/{document=**} {
      allow read, write: if isMe(uid);
    }
    // Avisos: cualquiera puede dejarte uno firmado con su uid; solo tú los lees y borras
    match /users/{uid}/avisos/{aid} {
      allow create: if signedIn() && request.resource.data.de == request.auth.uid
                    && request.resource.data.texto is string && request.resource.data.texto.size() <= 200;
    }

    // Perfil público
    match /perfiles/{uid} {
      allow read: if signedIn();
      allow write: if isMe(uid);
    }
    // Clubes de pádel añadidos por la comunidad
    match /clubs/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.by == request.auth.uid && request.resource.data.nombre is string && request.resource.data.nombre.size() <= 60;
      allow update, delete: if signedIn() && resource.data.by == request.auth.uid;
    }
    // Nombres de usuario únicos
    match /usuarios/{handle} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }
    // Seguir
    match /follows/{fid} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.de == request.auth.uid
                    && fid == request.auth.uid + '_' + request.resource.data.a;
      allow delete: if signedIn() && resource.data.de == request.auth.uid;
    }
    // Publicaciones del muro
    match /posts/{pid} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
      allow update: if signedIn() && (
        (resource.data.uid == request.auth.uid && request.resource.data.uid == request.auth.uid)
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['kudos'])
            && request.resource.data.kudos.toSet().difference(resource.data.kudos.toSet())
                 .union(resource.data.kudos.toSet().difference(request.resource.data.kudos.toSet()))
                 .hasOnly([request.auth.uid]))
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nCom'])
      );
      match /comentarios/{cid} {
        allow read: if signedIn();
        allow create: if signedIn() && request.resource.data.uid == request.auth.uid
                      && request.resource.data.texto is string && request.resource.data.texto.size() <= 500;
        allow delete: if signedIn() && (resource.data.uid == request.auth.uid
                      || get(/databases/$(database)/documents/posts/$(pid)).data.uid == request.auth.uid);
      }
    }
    // Opiniones de zapatillas (una por persona y modelo)
    match /zapas/{sid}/opiniones/{uid} {
      allow read: if signedIn();
      allow write: if isMe(uid) && (request.resource == null || (request.resource.data.uid == request.auth.uid
                    && request.resource.data.nota is int && request.resource.data.nota >= 1 && request.resource.data.nota <= 5));
    }
    // Preguntas y respuestas
    match /preguntas/{qid} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid
                    && request.resource.data.texto is string && request.resource.data.texto.size() <= 300;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
      allow update: if signedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nResp']);
      match /respuestas/{rid} {
        allow read: if signedIn();
        allow create: if signedIn() && request.resource.data.uid == request.auth.uid
                      && request.resource.data.texto is string && request.resource.data.texto.size() <= 600;
        allow delete: if signedIn() && resource.data.uid == request.auth.uid;
      }
    }
    // Partidos de pádel compartidos (solo los ven sus jugadores)
    match /partidos/{pid} {
      allow read: if signedIn() && request.auth.uid in resource.data.jugadores;
      allow create: if signedIn() && request.resource.data.creador == request.auth.uid
                    && request.auth.uid in request.resource.data.jugadores && request.resource.data.jugadores.size() <= 4;
      allow update: if signedIn() && request.auth.uid in resource.data.jugadores
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['conf', 'rech']);
      allow delete: if signedIn() && resource.data.creador == request.auth.uid;
    }
    // Partidos abiertos para buscar jugadores
    match /quedadas/{qid} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.creador == request.auth.uid && request.resource.data.jugadores.size() <= 4;
      allow delete: if signedIn() && resource.data.creador == request.auth.uid;
      allow update: if signedIn() && request.resource.data.jugadores.size() <= 4 && (
        (resource.data.creador == request.auth.uid && request.resource.data.creador == request.auth.uid)
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['jugadores', 'uids'])
            && request.resource.data.uids.toSet().difference(resource.data.uids.toSet())
                 .union(resource.data.uids.toSet().difference(request.resource.data.uids.toSet()))
                 .hasOnly([request.auth.uid])));
    }
    // Ligas: grupos con ranking propio. Cualquiera con sesión las ve; cada uno solo puede meterse o sacarse a sí mismo
    match /ligas/{lid} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.creador == request.auth.uid
                    && request.resource.data.miembros == [request.auth.uid]
                    && request.resource.data.nombre is string && request.resource.data.nombre.size() <= 50;
      allow update: if signedIn() && (
        (resource.data.creador == request.auth.uid && request.resource.data.creador == request.auth.uid)
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['miembros'])
            && request.resource.data.miembros.size() <= 300
            && request.resource.data.miembros.toSet().difference(resource.data.miembros.toSet())
                 .union(resource.data.miembros.toSet().difference(request.resource.data.miembros.toSet()))
                 .hasOnly([request.auth.uid])));
      allow delete: if signedIn() && resource.data.creador == request.auth.uid;
      match /msgs/{mid} {
        allow read: if signedIn() && request.auth.uid in get(/databases/$(database)/documents/ligas/$(lid)).data.miembros;
        allow create: if signedIn() && request.resource.data.uid == request.auth.uid
                      && request.auth.uid in get(/databases/$(database)/documents/ligas/$(lid)).data.miembros
                      && request.resource.data.texto is string && request.resource.data.texto.size() <= 500;
        allow delete: if signedIn() && (resource.data.uid == request.auth.uid
                      || get(/databases/$(database)/documents/ligas/$(lid)).data.creador == request.auth.uid);
      }
    }
    // Mensajes privados entre dos personas
    match /chats/{cid} {
      allow read: if signedIn() && request.auth.uid in resource.data.miembros;
      allow create: if signedIn() && request.auth.uid in request.resource.data.miembros
                    && request.resource.data.miembros.size() == 2;
      allow update: if signedIn() && request.auth.uid in resource.data.miembros
                    && request.resource.data.miembros == resource.data.miembros;
      match /msgs/{mid} {
        allow read: if signedIn() && request.auth.uid in get(/databases/$(database)/documents/chats/$(cid)).data.miembros;
        allow create: if signedIn() && request.resource.data.de == request.auth.uid
                      && request.auth.uid in get(/databases/$(database)/documents/chats/$(cid)).data.miembros
                      && request.resource.data.texto is string && request.resource.data.texto.size() <= 1000;
      }
    }
  }
}
